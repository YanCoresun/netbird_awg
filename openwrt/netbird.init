#!/bin/sh /etc/rc.common
# NetBird AWG client for OpenWrt with small flash.
# The binary lives in RAM (/tmp) and is downloaded on every boot from the fork's release;
# config/keys persist in /etc/netbird (NB_STATE_DIR).

START=99
STOP=10
USE_PROCD=1

ARCH="$(. /etc/openwrt_release; echo "$DISTRIB_ARCH")"
VERSION="v0.80.0-awg-r1"
URL="https://github.com/YanCoresun/netbird_awg/releases/download/openwrt-${VERSION}/netbird-${ARCH}"
BIN=/tmp/netbird
STATE=/etc/netbird

start_service() {
	mkdir -p "$STATE"
	procd_open_instance
	# wrapper: fetch the binary (retry until internet is up), then exec the daemon
	procd_set_param command /bin/sh -c "
		while [ ! -x $BIN ]; do
			uclient-fetch -q -T 30 -O $BIN.part '$URL' && mv $BIN.part $BIN && chmod +x $BIN && break
			rm -f $BIN.part; logger -t netbird 'download failed, retry in 15s'; sleep 15
		done
		exec $BIN service run --log-file console --log-level info
	"
	procd_set_param env NB_STATE_DIR="$STATE"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -x $BIN ] && NB_STATE_DIR="$STATE" $BIN down >/dev/null 2>&1
	return 0
}
